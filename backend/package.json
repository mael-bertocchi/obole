{
  "name": "@obole/backend",
  "description": "The Fastify backend for Obole, a personal portal: its passkey identity and the data of its apps.",
  "version": "6.4.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "start": "prisma migrate deploy && node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.2.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@simplewebauthn/server": "^14.0.3",
    "@sinclair/typebox": "^0.34.49",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.7",
    "fastify": "^5.6.2",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "http-status-codes": "^2.3.0",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "eslint": "^10.1.0",
    "eslint-plugin-import-x": "^4.16.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "fsevents": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
