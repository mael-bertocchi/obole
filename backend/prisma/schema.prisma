generator client {
  provider            = "prisma-client"
  output              = "./generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model IdentityRefreshSession {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("identity_refresh_sessions")
}

model IdentityPasskey {
  id         String    @id
  publicKey  Bytes     @map("public_key")
  counter    Int       @default(0)
  transports String[]  @default([])
  aaguid     String
  name       String?
  backedUp   Boolean   @default(false) @map("backed_up")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@map("identity_passkeys")
}

model BudgetCategory {
  id           String   @id
  name         String
  symbol       String
  colorHex     Int      @map("color_hex")
  monthlyLimit Float    @default(0) @map("monthly_limit")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("budget_categories")
}

model BudgetOperation {
  id           String    @id
  date         DateTime
  name         String
  description  String?
  categoryId   String    @map("category_id")
  location     String?
  amount       Float
  currencyCode String    @default("EUR") @map("currency_code")
  rateToEuro   Float     @default(1) @map("rate_to_euro")
  isOnline     Boolean   @default(false) @map("is_online")
  isRecurring  Boolean   @default(false) @map("is_recurring")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([date])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("budget_operations")
}

model BudgetHistory {
  month          String   @id
  monthlyLimit   Float    @map("monthly_limit")
  categoryLimits Json     @map("category_limits")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("budget_history")
}

model BudgetState {
  id           String   @id
  monthlyLimit Float    @default(3000) @map("monthly_limit")
  revision     Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("budget_state")
}

model BudgetExchangeRateSnapshot {
  id        String   @id
  quoteDate String   @map("quote_date")
  rates     Json
  fetchedAt DateTime @map("fetched_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("budget_exchange_rate_snapshots")
}

enum WatchlistMediaType {
  movie
  tv

  @@map("watchlist_media_type")
}

model WatchlistEntry {
  id               String             @id @default(uuid())
  tmdbId           Int                @map("tmdb_id")
  mediaType        WatchlistMediaType @map("media_type")
  titleEn          String             @map("title_en")
  titleFr          String             @map("title_fr")
  originalTitle    String             @map("original_title")
  releaseDate      String?            @map("release_date")
  posterPath       String?            @map("poster_path")
  genreIds         Int[]              @default([]) @map("genre_ids")
  collectionId     Int?               @map("collection_id")
  collectionNameEn String?            @map("collection_name_en")
  collectionNameFr String?            @map("collection_name_fr")
  runtime          Int?
  seasons          Int?
  addedAt          DateTime           @default(now()) @map("added_at")
  watchedAt        DateTime?          @map("watched_at")
  rating           Int?
  comment          String?
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@unique([mediaType, tmdbId])
  @@index([watchedAt])
  @@map("watchlist_entries")
}
