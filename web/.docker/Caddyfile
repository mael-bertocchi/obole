:80 {
	# Enable gzip compression
	encode gzip

	# Serve static files
	root * /usr/share/caddy

	# Security headers on every response; the page only ever talks to itself and to the portal's API
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://image.tmdb.org; connect-src 'self' https://api-obole.mael-bertocchi.fr; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Cache the fingerprinted build output for good
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Handle all other requests
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Log requests
	log {
		output stdout
		format json
	}
}
